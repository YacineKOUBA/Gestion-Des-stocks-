// ============================================================
// GD TRADING - schema.prisma (modele de donnees V1)
// Source de verite. Migrations : npx prisma migrate dev
// Reference : docs/06_MODELE_DONNEES.md
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- ENUMS -----------------------------

enum RoleCode {
  ADMIN
  MAGASINIER
}

enum PartnerType {
  FOURNISSEUR
  CLIENT
  ENTITE
  AUTRE
}

enum ArticleEmploi {
  PRODUCTION
  REVENTE_EN_LETAT
  MIXTE
}

enum SourceAchat {
  INTERNATIONAL
  LOCAL
  MIXTE
  NON_DEFINI
}

enum ArticleStatut {
  ACTIVE
  INACTIVE
}

enum MoveTypeCode {
  ENTREE
  SORTIE
  TRANSFERT
  PERTE
  AJUSTEMENT
  RETOUR
  RESERVATION
}

enum MoveStatus {
  ACTIF
  ANNULE
}

enum InventoryStatus {
  OUVERTE
  CLOTUREE
}

enum InventoryLineStatus {
  A_COMPTER
  COMPTE
  VALIDE
  REFUSE
}

enum InventoryDecision {
  AJUSTEMENT
  PERTE
}

enum LoanType {
  PRET
  EMPRUNT
}

enum LoanStatus {
  OUVERT
  PARTIEL
  CLOTURE
}

enum RestitutionType {
  RESTITUTION_PRET
  RESTITUTION_EMPRUNT
}

enum BonType {
  ENTREE
  SORTIE
  LIVRAISON
  TRANSFERT
  RETOUR
}

enum AuditAction {
  CREATION
  MODIFICATION
  SUPPRESSION
  VALIDATION
  ANNULATION
  REACTIVATION
  CONNEXION
  REFUS
}

enum AlertLevel {
  RED
  ORANGE
  GREEN
}

// --------------------- UTILISATEURS ET ROLES ---------------------

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  login        String   @unique @db.VarChar(50)
  passwordHash String   @db.VarChar(255)
  displayName  String?  @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  createdBy    Int?
  createdActor User?  @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  auditLogs           AuditLog[]
  movesMade           Move[]        @relation("MoveCreatedBy")
  movesCanceled       Move[]        @relation("MoveCanceledBy")
  reservationsStaff   Reservation[] @relation("ReservationStaff")
  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  reservationsClosed  Reservation[] @relation("ReservationClosedBy")

  @@index([roleId])
  @@map("users")
}

model Role {
  id    Int      @id @default(autoincrement())
  code  RoleCode @unique
  label String   @db.VarChar(50)
  users User[]
}

// ------------------------ REFERENTIELS ------------------------

model Category {
  id       Int         @id @default(autoincrement())
  code     String      @unique @db.VarChar(30)
  label    String      @db.VarChar(50)
  sort     Int?
  articles Article[]
  families Family[]
  series   CodeSeries?
}

model CodeSeries {
  id         Int      @id @default(autoincrement())
  categoryId Int      @unique
  category   Category @relation(fields: [categoryId], references: [id])
  prefix     String   @db.VarChar(6)
  nextValue  Int      @default(1) @map("next_value")
  digits     Int      @default(6)
}

model Family {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(20)
  label      String    @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])
  articles   Article[]

  @@index([categoryId])
  @@map("families")
}

model Unit {
  id       Int       @id @default(autoincrement())
  code     String    @unique @db.VarChar(10)
  label    String    @db.VarChar(30)
  articles Article[]
}

model Packaging {
  id      Int       @id @default(autoincrement())
  label   String    @unique @db.VarChar(50)
  Article Article[]
}

model Origin {
  id      Int       @id @default(autoincrement())
  code    String    @unique @db.VarChar(5)
  label   String    @db.VarChar(60)
  region  String?   @db.VarChar(60)
  Article Article[]
}

model Partner {
  id       Int         @id @default(autoincrement())
  name     String      @db.VarChar(150)
  type     PartnerType
  isActive Boolean     @default(true) @map("is_active")

  moves        Move[]
  orders       ArticleOrder[]
  loans        Loan[]
  bons         Bon[]
  reservations Reservation[]
}

model Depot {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  label    String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  moves       Move[]         @relation("MoveDepot")
  movesDest   Move[]         @relation("MoveDepotDest")
  orders      ArticleOrder[]
  inventories Inventory[]
  bons        Bon[]          @relation("BonDepot")
  bonsDest    Bon[]          @relation("BonDepotDest")
}

model Location {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  label    String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  moves     Move[] @relation("MoveLocation")
  movesDest Move[] @relation("MoveLocationDest")
  inventoryLines InventoryLine[]
}

// --------------------------- ARTICLES ---------------------------

model Article {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(10)
  designation  String        @db.VarChar(200)
  designation2 String?       @map("designation_2") @db.VarChar(200)
  fabricant    String?       @db.VarChar(100)
  emploiGd     ArticleEmploi @default(PRODUCTION) @map("emploi_gd")
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  familyId     Int?
  family       Family?       @relation(fields: [familyId], references: [id])
  application  String?       @db.VarChar(150)
  unitId       Int
  unit         Unit          @relation(fields: [unitId], references: [id])
  packagingId  Int?
  packaging    Packaging?    @relation(fields: [packagingId], references: [id])
  sourceAchat  SourceAchat?  @map("source_achat")
  originId     Int?
  origin       Origin?       @relation(fields: [originId], references: [id])
  periode      String?       @db.VarChar(20)
  frequence    Int?
  statut       ArticleStatut @default(ACTIVE)
  unitPrice    Decimal?      @map("unit_price") @db.Decimal(14, 4)
  currency     String        @default("DZD") @db.VarChar(3)
  isLotTracked Boolean       @default(false) @map("is_lot_tracked")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  consumptions     ArticleConsumption[]
  orders           ArticleOrder[]
  priceHistory     PriceHistory[]
  lots             Lot[]
  movements        Move[]
  inventoryLines   InventoryLine[]
  loans            Loan[]
  bonLines         BonLine[]
  reservationLines ReservationLine[]

  @@index([familyId])
  @@index([categoryId])
  @@map("articles")
}

model ArticleConsumption {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id])
  year      Int
  month     Int
  quantity  Decimal @default(0) @db.Decimal(14, 3)

  @@unique([articleId, year, month])
  @@map("article_consumption")
}

model ArticleOrder {
  id           Int      @id @default(autoincrement())
  articleId    Int
  article      Article  @relation(fields: [articleId], references: [id])
  quantity     Decimal  @db.Decimal(14, 3)
  expectedDate DateTime @map("expected_date") @db.Date
  supplierId   Int?
  supplier     Partner? @relation(fields: [supplierId], references: [id])
  arrived      Boolean  @default(false)
  depotId      Int?
  depot        Depot?   @relation(fields: [depotId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("article_orders")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id])
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 4)
  currency  String   @default("DZD") @db.VarChar(3)
  changedBy Int?
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  @@map("price_history")
}

// ------------------------ LOTS ET MOUVEMENTS ------------------------

model Lot {
  id          Int       @id @default(autoincrement())
  articleId   Int
  article     Article   @relation(fields: [articleId], references: [id])
  lotNumber   String    @map("lot_number") @db.VarChar(50)
  fabricDate  DateTime? @map("fabric_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date
  unitPrice   Decimal?  @map("unit_price") @db.Decimal(14, 4)
  observation String?   @db.Text

  movements      Move[]
  inventoryLines InventoryLine[]
  bonLines       BonLine[]

  @@unique([articleId, lotNumber])
  @@index([expiryDate])
  @@map("lots")
}

model MoveType {
  id    Int          @id @default(autoincrement())
  code  MoveTypeCode @unique
  label String       @db.VarChar(30)
  sens  Int
  moves Move[]
}

model Move {
  id             BigInt     @id @default(autoincrement()) @db.BigInt
  typeId         Int
  type           MoveType   @relation(fields: [typeId], references: [id])
  articleId      Int
  article        Article    @relation(fields: [articleId], references: [id])
  lotId          Int?
  lot            Lot?       @relation(fields: [lotId], references: [id])
  quantity       Decimal    @db.Decimal(14, 3)
  sens           Int
  depotId        Int
  depot          Depot      @relation("MoveDepot", fields: [depotId], references: [id])
  locationId     Int?
  location       Location?  @relation("MoveLocation", fields: [locationId], references: [id])
  depotDestId    Int?       @map("depot_dest_id")
  depotDest      Depot?     @relation("MoveDepotDest", fields: [depotDestId], references: [id])
  locationDestId Int?       @map("location_dest_id")
  locationDest   Location?  @relation("MoveLocationDest", fields: [locationDestId], references: [id])
  partnerId      Int?
  partner        Partner?   @relation(fields: [partnerId], references: [id])
  docNumber      String?    @map("doc_number") @db.VarChar(50)
  unitPrice      Decimal?   @map("unit_price") @db.Decimal(14, 4)
  currency       String     @default("DZD") @db.VarChar(3)
  movementDate   DateTime   @map("movement_date") @db.Date
  observation    String?    @db.VarChar(255)
  linkMoveId     BigInt?    @map("link_move_id")
  linkedMove     Move?      @relation("MoveLink", fields: [linkMoveId], references: [id])
  linkedMoves    Move[]     @relation("MoveLink")
  remediation    String?    @db.VarChar(20)
  inventoryId    BigInt?
  inventory      Inventory? @relation(fields: [inventoryId], references: [id])
  status         MoveStatus @default(ACTIF)
  canceledBy     Int?
  canceler       User?      @relation("MoveCanceledBy", fields: [canceledBy], references: [id])
  canceledAt     DateTime?  @map("canceled_at") @db.Timestamptz()
  createdBy      Int
  creator        User?      @relation("MoveCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  loan          Loan?             @relation("LoanMove")
  restitutions  LoanRestitution[] @relation("RestitutionMove")
  inventoryLine InventoryLine?    @relation("InventoryLineMove")
  reservationId BigInt?           @map("reservation_id")
  reservation   Reservation?      @relation(fields: [reservationId], references: [id])

  @@index([articleId])
  @@index([lotId])
  @@index([depotId])
  @@index([movementDate])
  @@map("moves")
}

// --------------------------- RESERVATIONS ---------------------------
// Une reservation BLOQUE du stock pour un acteur et une periode donnees.
// Chaque article reserve genere un mouvement de type RESERVATION (sens -1) : le stock
// disponible baisse donc exactement comme pour une sortie ou un pret. A l'annulation
// (manuelle ou automatique a l'echeance) ces mouvements passent en ANNULE et le stock
// redevient disponible ; a la realisation ils deviennent de vraies SORTIES.

enum ReservationStatus {
  ACTIF
  REALISE
  ANNULE
  EXPIRE
}

model Reservation {
  id          BigInt            @id @default(autoincrement()) @db.BigInt
  ref         String            @unique @db.VarChar(30)
  partnerId   Int
  partner     Partner           @relation(fields: [partnerId], references: [id])
  staffLabel String            @map("staff_label") @db.VarChar(100)
  staffId     Int?
  staff       User?             @relation("ReservationStaff", fields: [staffId], references: [id])
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime          @map("end_date") @db.Date
  status      ReservationStatus @default(ACTIF)
  observation String?           @db.VarChar(255)
  createdBy   Int
  creator     User?             @relation("ReservationCreatedBy", fields: [createdBy], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  closedBy    Int?
  closer      User?             @relation("ReservationClosedBy", fields: [closedBy], references: [id])
  closedAt    DateTime?         @map("closed_at") @db.Timestamptz()
  closeReason String?           @map("close_reason") @db.VarChar(20)

  lines ReservationLine[]
  moves Move[]

  @@index([status])
  @@index([endDate])
  @@index([partnerId])
  @@map("reservations")
}

model ReservationLine {
  id            BigInt      @id @default(autoincrement()) @db.BigInt
  reservationId BigInt
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  articleId     Int
  article       Article     @relation(fields: [articleId], references: [id])
  quantity      Decimal     @db.Decimal(14, 3)

  @@index([articleId])
  @@map("reservation_lines")
}

// --------------------------- INVENTAIRE ---------------------------

model Inventory {
  id       BigInt          @id @default(autoincrement()) @db.BigInt
  code     String          @unique @db.VarChar(20)
  title    String?         @db.VarChar(150)
  depotId  Int?
  depot    Depot?          @relation(fields: [depotId], references: [id])
  openedAt DateTime        @default(now()) @map("opened_at") @db.Timestamptz()
  openedBy Int
  closedAt DateTime?       @map("closed_at") @db.Timestamptz()
  closedBy Int?
  status   InventoryStatus @default(OUVERTE)

  lines     InventoryLine[]
  movements Move[]

  @@map("inventories")
}

model InventoryLine {
  id             BigInt              @id @default(autoincrement()) @db.BigInt
  inventoryId    BigInt
  inventory      Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  articleId      Int
  article        Article             @relation(fields: [articleId], references: [id])
  lotId     Int?
  lot       Lot?               @relation(fields: [lotId], references: [id])
  locationId     Int?
  location       Location?          @relation(fields: [locationId], references: [id])
  qtyTheoretical Decimal             @map("qty_theoretical") @db.Decimal(14, 3)
  qtyCounted     Decimal?            @map("qty_counted") @db.Decimal(14, 3)
  variance       Decimal?            @db.Decimal(14, 3)
  status         InventoryLineStatus @default(A_COMPTER)
  decision       InventoryDecision?
  lossReason     String?             @map("loss_reason") @db.VarChar(150)
  movementId     BigInt?             @unique
  movement       Move?               @relation("InventoryLineMove", fields: [movementId], references: [id])
  countedAt      DateTime?           @map("counted_at") @db.Timestamptz()
  countedBy      Int?
  validatedAt    DateTime?           @map("validated_at") @db.Timestamptz()
  validatedBy    Int?

  @@unique([inventoryId, articleId, lotId, locationId])
  @@map("inventory_lines")
}

// --------------------- PRETS / EMPRUNTS / RESTITUTIONS ---------------------

model Loan {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  type        LoanType
  partnerId   Int
  partner     Partner    @relation(fields: [partnerId], references: [id])
  articleId   Int
  article     Article    @relation(fields: [articleId], references: [id])
  quantity    Decimal    @db.Decimal(14, 3)
  loanDate    DateTime   @map("loan_date") @db.Date
  observation String?    @db.VarChar(255)
  movementId  BigInt?    @unique
  move        Move?      @relation("LoanMove", fields: [movementId], references: [id])
  status      LoanStatus @default(OUVERT)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  restitutions LoanRestitution[]

  @@map("loans")
}

model LoanRestitution {
  id         BigInt          @id @default(autoincrement()) @db.BigInt
  loanId     BigInt
  loan       Loan            @relation(fields: [loanId], references: [id])
  type       RestitutionType
  quantity   Decimal         @db.Decimal(14, 3)
  restDate   DateTime        @map("rest_date") @db.Date
  movementId BigInt?         @unique
  move       Move?           @relation("RestitutionMove", fields: [movementId], references: [id])
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  @@map("loan_restitutions")
}

// ------------------------------- BONS -------------------------------

model Bon {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  ref          String   @unique @db.VarChar(20)
  type         BonType
  depotId      Int?
  depot        Depot?   @relation("BonDepot", fields: [depotId], references: [id])
  depotDestId  Int?     @map("depot_dest_id")
  depotDest    Depot?   @relation("BonDepotDest", fields: [depotDestId], references: [id])
  partnerId    Int?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  bonDate      DateTime @map("bon_date") @db.Date
  currency     String   @default("DZD") @db.VarChar(3)
  montantTotal Decimal  @default(0) @map("montant_total") @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lines BonLine[]

  @@map("bons")
}

model BonLine {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  bonId       BigInt
  bon         Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)
  articleId   Int
  article     Article  @relation(fields: [articleId], references: [id])
  lotId       Int?
  lot         Lot?     @relation(fields: [lotId], references: [id])
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(14, 4)
  montant     Decimal  @default(0) @db.Decimal(18, 4)
  observation String?  @db.VarChar(255)

  @@map("bon_lines")
}

// ------------------- PARAMETRES / ALERTES / AUDIT -------------------

model Setting {
  id    Int     @id @default(autoincrement())
  code  String  @unique @db.VarChar(40)
  value String  @db.VarChar(50)
  label String? @db.VarChar(100)

  @@map("settings")
}

model NotificationAlert {
  id        BigInt     @id @default(autoincrement()) @db.BigInt
  type      String     @db.VarChar(30)
  articleId Int?
  lotId     Int?
  message   String?    @db.VarChar(255)
  level     AlertLevel
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  resolved  Boolean    @default(false)

  @@map("notification_alert")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement()) @db.BigInt
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String      @db.VarChar(50)
  entityId  String?     @map("entity_id")
  changes   Json?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_log")
}
